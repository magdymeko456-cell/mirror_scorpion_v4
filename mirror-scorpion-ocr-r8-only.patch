Subject: [PATCH] fix(ci): include ML Kit OCR script modules

---
 .github/workflows/build_apk.yml | 21 +++++++++++++++++++++
 todo.md                         |  2 ++
 2 files changed, 23 insertions(+)

diff --git a/.github/workflows/build_apk.yml b/.github/workflows/build_apk.yml
index dedfee8..d002031 100644
--- a/.github/workflows/build_apk.yml
+++ b/.github/workflows/build_apk.yml
@@ -65,6 +65,27 @@ jobs:
             echo "Android app Gradle file was not generated."
             exit 1
           fi
+          if [ -f android/app/build.gradle.kts ]; then
+            cat <<'EOF' >> android/app/build.gradle.kts
+
+dependencies {
+    implementation("com.google.mlkit:text-recognition-chinese:16.0.1")
+    implementation("com.google.mlkit:text-recognition-devanagari:16.0.1")
+    implementation("com.google.mlkit:text-recognition-japanese:16.0.1")
+    implementation("com.google.mlkit:text-recognition-korean:16.0.1")
+}
+EOF
+          else
+            cat <<'EOF' >> android/app/build.gradle
+
+dependencies {
+    implementation 'com.google.mlkit:text-recognition-chinese:16.0.1'
+    implementation 'com.google.mlkit:text-recognition-devanagari:16.0.1'
+    implementation 'com.google.mlkit:text-recognition-japanese:16.0.1'
+    implementation 'com.google.mlkit:text-recognition-korean:16.0.1'
+}
+EOF
+          fi
       - name: Install dependencies
         run: flutter pub get
       - name: Static analysis
diff --git a/todo.md b/todo.md
index cf5ff0f..ac90c3e 100644
--- a/todo.md
+++ b/todo.md
@@ -121,4 +121,6 @@
