+      }
+    });
+  }
+
+  void _checkStoryDraft() {
+    final result = InspirationSafety.assessStoryDraft(_storyDraftController.text);
+    setState(() => _notice = result.message);
+  }
+
   @override
   void dispose() {
     _speechService.removeListener(_onSpeechChanged);
     _speechService.stop();
