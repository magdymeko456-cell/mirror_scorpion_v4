import 'package:flutter/material.dart';

import '../../app/royal_dark_theme.dart';

class DashboardScreen extends StatelessWidget {
  const DashboardScreen({super.key});

  static const _features = <_FeatureSpec>[
    _FeatureSpec('ترجمة نصية', 'نص، صوت، لغات وحزم أوف لاين', Icons.translate, RoyalColors.cyan),
    _FeatureSpec('حوار مترجم', 'محادثة ثنائية اللغة مع تسجيل فعلي', Icons.forum_outlined, RoyalColors.teal),
    _FeatureSpec('مستندات وعدسة', 'OCR للصور والمستندات مع عرض مزدوج', Icons.document_scanner_outlined, RoyalColors.gold),
    _FeatureSpec('قصص وإلهام', 'مصادر، قراءة صوتية، ورسائل هادفة', Icons.auto_stories_outlined, RoyalColors.purple),
    _FeatureSpec('ساحة الألعاب', 'شطرنج، مؤقت، وروبيك تعليمي', Icons.sports_esports_outlined, RoyalColors.cyan),
    _FeatureSpec('الإعدادات وPRO', 'لغة، فقاعة، تنزيلات وتفعيل آمن', Icons.settings_outlined, RoyalColors.gold),
  ];

  @override
  Widget build(BuildContext context) {
    return Directionality(
      textDirection: TextDirection.rtl,
      child: Scaffold(
        appBar: AppBar(title: const Text('Mirror Scorpion v4')),
        body: ListView(
          padding: const EdgeInsets.fromLTRB(18, 8, 18, 32),
          children: [
            const _RoyalHero(),
            const SizedBox(height: 18),
            ..._features.map(
              (feature) => Padding(
                padding: const EdgeInsets.only(bottom: 12),
                child: _FeatureCard(feature: feature),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

class _RoyalHero extends StatelessWidget {
  const _RoyalHero();

  @override
  Widget build(BuildContext context) {
    return Container(
      padding: const EdgeInsets.all(22),
      decoration: BoxDecoration(
        borderRadius: BorderRadius.circular(24),
        border: Border.all(color: RoyalColors.cyan.withValues(alpha: 0.5)),
        gradient: const LinearGradient(
          colors: [Color(0xFF122A4A), RoyalColors.midnight],
          begin: Alignment.topRight,
          end: Alignment.bottomLeft,
        ),
      ),
      child: const Column(
        children: [
          Icon(Icons.bug_report_outlined, size: 54, color: RoyalColors.gold),
          SizedBox(height: 10),
          Text('المِرآة الملكية', style: TextStyle(fontSize: 24, fontWeight: FontWeight.w800)),
          SizedBox(height: 6),
          Text('منصة Flutter آمنة تبدأ بالكروت الستة دون ادعاء ميزات غير مرتبطة بعد.', textAlign: TextAlign.center, style: TextStyle(color: RoyalColors.muted, height: 1.5)),
        ],
      ),
    );
  }
}

class _FeatureCard extends StatelessWidget {
  const _FeatureCard({required this.feature});

  final _FeatureSpec feature;

  @override
  Widget build(BuildContext context) {
    return Card(
      child: InkWell(
        borderRadius: BorderRadius.circular(22),
        onTap: () => Navigator.of(context).push(
          MaterialPageRoute<void>(builder: (_) => _FeatureShell(feature: feature)),
        ),
        child: Padding(
          padding: const EdgeInsets.all(18),
          child: Row(
            children: [
              Container(
                width: 54,
                height: 54,
                decoration: BoxDecoration(color: feature.color.withValues(alpha: 0.13), shape: BoxShape.circle),
                child: Icon(feature.icon, color: feature.color),
              ),
              const SizedBox(width: 14),
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(feature.title, style: const TextStyle(fontSize: 18, fontWeight: FontWeight.w800)),
                    const SizedBox(height: 4),
                    Text(feature.subtitle, style: const TextStyle(color: RoyalColors.muted, height: 1.4)),
                  ],
                ),
              ),
              Icon(Icons.chevron_left, color: feature.color),
            ],
          ),
        ),
      ),
    );
  }
}

class _FeatureShell extends StatelessWidget {
  const _FeatureShell({required this.feature});

  final _FeatureSpec feature;

  @override
  Widget build(BuildContext context) {
    return Directionality(
      textDirection: TextDirection.rtl,
      child: Scaffold(
        appBar: AppBar(title: Text(feature.title)),
        body: Padding(
          padding: const EdgeInsets.all(20),
          child: Center(
            child: Text(
              'يُنقل هذا القسم في المرحلة التالية من خطة Flutter.\n${feature.subtitle}',
              textAlign: TextAlign.center,
              style: const TextStyle(fontSize: 16, color: RoyalColors.muted, height: 1.6),
            ),
          ),
        ),
      ),
    );
  }
}

class _FeatureSpec {
  const _FeatureSpec(this.title, this.subtitle, this.icon, this.color);

  final String title;
  final String subtitle;
  final IconData icon;
  final Color color;
}
