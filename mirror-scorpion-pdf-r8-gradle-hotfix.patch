From da6be1764efd2c696987b24b8ff79527839e8d2d Mon Sep 17 00:00:00 2001
From: Manus Patch Builder <patch-builder@users.noreply.github.com>
Date: Tue, 25 Aug 2026 19:25:05 +0000
Subject: [PATCH] fix(ci): attach PDF R8 rule to release build

---
 .github/workflows/build_apk.yml | 35 ++++++++++++++++++++++++++++-----
 1 file changed, 30 insertions(+), 5 deletions(-)

diff --git a/.github/workflows/build_apk.yml b/.github/workflows/build_apk.yml
index 9417787..e3926bc 100644
--- a/.github/workflows/build_apk.yml
+++ b/.github/workflows/build_apk.yml
@@ -104,12 +104,37 @@ jobs:
           fi
       - name: Configure PDF text extraction R8 rule
         run: |
-          test -f android/app/proguard-rules.pro || {
-            echo "Expected Flutter Android ProGuard rules were not generated."
-            exit 1
+          cat > android/app/mirror-scorpion-pdf-r8.pro <<'EOF'
+          # PDFBox references an optional JPX decoder. Text extraction does not package it.
+          -dontwarn com.gemalto.jp2.**
+          EOF
+          if [ -f android/app/build.gradle.kts ]; then
+            cat >> android/app/build.gradle.kts <<'EOF'
+
+          android {
+              buildTypes {
+                  getByName("release") {
+                      proguardFiles("mirror-scorpion-pdf-r8.pro")
+                  }
+              }
+          }
+          EOF
+          elif [ -f android/app/build.gradle ]; then
+            cat >> android/app/build.gradle <<'EOF'
+
+          android {
+              buildTypes {
+                  release {
+                      proguardFiles 'mirror-scorpion-pdf-r8.pro'
+                  }
+              }
           }
-          printf '\n# PDFBox references an optional JPX decoder; text extraction does not package it.\n-dontwarn com.gemalto.jp2.**\n' >> android/app/proguard-rules.pro
-          grep -q -- '-dontwarn com.gemalto.jp2.\*\*' android/app/proguard-rules.pro
+          EOF
+          else
+            echo "Android app Gradle file was not generated."
+            exit 1
+          fi
+          grep -q -- '-dontwarn com.gemalto.jp2.\*\*' android/app/mirror-scorpion-pdf-r8.pro
       - name: Install dependencies
         run: flutter pub get
       - name: Generate scorpion Android launcher icon
-- 
2.43.0

